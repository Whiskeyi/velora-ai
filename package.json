{
  "name": "velora-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A streaming-first React component system for agentic AI interfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whiskeyi/velora-ai.git"
  },
  "homepage": "https://ai.components.zhuchj.com/",
  "bugs": {
    "url": "https://github.com/Whiskeyi/velora-ai/issues"
  },
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "build:pages": "vp build --config vite.pages.config.ts && node scripts/prepare-pages-routes.mjs",
    "build:library": "vp pack",
    "build:all": "vp pack && vp build",
    "preview": "vp preview",
    "preview:pages": "vp preview --config vite.pages.config.ts --host 127.0.0.1 --port 4174",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "typecheck": "vp exec tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:showcase": "node scripts/verify-showcase-samples.mjs",
    "verify:site-css": "node scripts/verify-site-css.mjs",
    "verify:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-live": "^4.1.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@playwright/test": "^1.62.0",
    "@types/katex": "^0.16.7",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "@voidzero-dev/vite-plus-core": "0.2.6",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vitest": "4.1.10"
  }
}
