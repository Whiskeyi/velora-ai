{
  "name": "@velora-ai/react",
  "version": "0.1.0",
  "description": "Streaming-first React primitives for agentic AI products.",
  "keywords": [
    "agent",
    "ai",
    "react",
    "sse",
    "streaming",
    "ui-components"
  ],
  "homepage": "https://ai.components.zhuchj.com/",
  "bugs": {
    "url": "https://github.com/Whiskeyi/velora-ai/issues"
  },
  "license": "MIT",
  "author": "Velora AI Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whiskeyi/velora-ai.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components-entry.d.mts",
      "import": "./dist/components-entry.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.mts",
      "import": "./dist/runtime-entry.mjs"
    },
    "./transport": {
      "types": "./dist/transport-entry.d.mts",
      "import": "./dist/transport-entry.mjs"
    },
    "./hooks": {
      "types": "./dist/hooks-entry.d.mts",
      "import": "./dist/hooks-entry.mjs"
    },
    "./rich-content": {
      "types": "./dist/rich-content-entry.d.mts",
      "import": "./dist/rich-content-entry.mjs"
    },
    "./rich-content/code-block": {
      "types": "./dist/code-block-entry.d.mts",
      "import": "./dist/code-block-entry.mjs"
    },
    "./rich-content/formula": {
      "types": "./dist/formula-entry.d.mts",
      "import": "./dist/formula-entry.mjs"
    },
    "./rich-content/markdown": {
      "types": "./dist/markdown-entry.d.mts",
      "import": "./dist/markdown-entry.mjs"
    },
    "./rich-content/mermaid": {
      "types": "./dist/mermaid-entry.d.mts",
      "import": "./dist/mermaid-entry.mjs"
    },
    "./styles.css": "./dist/style.css",
    "./rich-content.css": "./dist/rich-content.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "mermaid": "^11.12.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  }
}
